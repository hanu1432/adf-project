			"scriptLines": [
				"source(output(",
				"          customer_id as string,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          phone as string,",
				"          city as string,",
				"          country as string,",
				"          signup_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 0,",
				"     ignoreNoFilesFound: false) ~> customers",
				"source(output(",
				"          order_id as integer,",
				"          customer_id as integer,",
				"          product_id as integer,",
				"          quantity as integer,",
				"          order_date as date,",
				"          order_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> orders",
				"source(output(",
				"          product_id as integer,",
				"          product_name as string,",
				"          category as string,",
				"          price as double,",
				"          stock_quantity as integer,",
				"          brand as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Prducts",
				"source(output(",
				"          payment_id as integer,",
				"          order_id as integer,",
				"          payment_date as date,",
				"          payment_method as string,",
				"          payment_status as string,",
				"          payment_amount as double,",
				"          currency as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Payments",
				"customers cast(output(",
				"          customer_id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          phone as long,",
				"          city as string,",
				"          country as string,",
				"          signup_date as date",
				"     ),",
				"     errors: true) ~> datatypes",
				"datatypes derive(Full_name = concat(first_name,' ', last_name)) ~> derivedColumn1",
				"select1 alterRow(upsertIf(true())) ~> alterRow1",
				"derivedColumn1 select(mapColumn(",
				"          Customer_id = customer_id,",
				"          Full_name,",
				"          Email = email,",
				"          Phone = phone,",
				"          City = city,",
				"          Country = country,",
				"          Signup_date = signup_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"orders select(mapColumn(",
				"          Order_id = order_id,",
				"          Customer_id = customer_id,",
				"          Product_id = product_id,",
				"          Quantity = quantity,",
				"          Order_date = order_date,",
				"          Order_status = order_status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 alterRow(upsertIf(true())) ~> alterRow2",
				"Prducts select(mapColumn(",
				"          Product_id = product_id,",
				"          Product_name = product_name,",
				"          Category = category,",
				"          Price = price,",
				"          Stock_quantity = stock_quantity,",
				"          Brand = brand",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 alterRow(upsertIf(true())) ~> alterRow3",
				"Payments select(mapColumn(",
				"          Payment_id = payment_id,",
				"          Order_id = order_id,",
				"          Payment_date = payment_date,",
				"          Payment_method = payment_method,",
				"          Payment_status = payment_status,",
				"          Payment_amount = payment_amount,",
				"          Currency = currency",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 alterRow(upsertIf(true())) ~> alterRow4",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'silver_layer/Customers',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['Customer_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Customer_id,",
				"          Full_name,",
				"          Email,",
				"          Phone,",
				"          City,",
				"          Country,",
				"          Signup_date",
				"     )) ~> sink1",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'silver_layer/Orders',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['Order_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Orddetails",
				"alterRow3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'silver_layer/Products',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['Product_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Products",
				"alterRow4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
